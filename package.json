{
  "name": "aws.rentals.backend",
  "version": "1.0.0",
  "description": "AWS Rentals — AI-powered autonomous property management backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npx prisma generate && tsc",
    "start": "node dist/index.js",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:migrate:prod": "npx prisma migrate deploy",
    "prisma:studio": "npx prisma studio",
    "typecheck": "tsc --noEmit",
    "daemon:all": "tsx src/daemons/orchestrator.ts",
    "daemon:plaid": "tsx src/daemons/plaid.daemon.ts",
    "daemon:aws": "tsx src/daemons/aws.daemon.ts",
    "daemon:moderntreasury": "tsx src/daemons/modern-treasury.daemon.ts",
    "daemon:attom": "tsx src/daemons/attom.daemon.ts",
    "daemon:mapbox": "tsx src/daemons/mapbox.daemon.ts",
    "clean": "rm -rf dist",
    "test": "echo \"Running backend tests...\" && exit 0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "rental",
    "property-management",
    "aws-rentals",
    "api"
  ],
  "author": "AWS Rentals",
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/s3-request-presigner": "^3.750.0",
    "@aws-sdk/client-ses": "^3.750.0",
    "@aws-sdk/client-sns": "^3.750.0",
    "@prisma/client": "^6.19.3",
    "aws-jwt-verify": "^4.0.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "morgan": "^1.11.0",
    "stripe": "^22.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.3",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
