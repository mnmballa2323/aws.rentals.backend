# ─────────────────────────────────────────────────────────
# Rental Home Backend — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rental_home?schema=public

# AWS Infrastructure Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Amazon Cognito Authentication
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=your-cognito-client-id

# Amazon Bedrock AI Agents
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Amazon S3 Document Storage
S3_BUCKET_NAME=aws-rentals-documents

# Amazon SES & SNS Legal Communications
SES_FROM_EMAIL=compliance@aws-rentals.internal
SNS_REGION=us-east-1

# ATTOM Data API
ATTOM_API_KEY=your-attom-api-key
ATTOM_BASE_URL=https://api.gateway.attomdata.com
ATTOM_RATE_LIMIT=200

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Checkr (Tenant Screening)
CHECKR_API_KEY=your-checkr-api-key
CHECKR_BASE_URL=https://api.checkr.com

# Plaid (Bank Account Verification)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox

# Twilio (SMS/Communication)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# BoldSign (E-Signatures)
BOLDSIGN_API_KEY=your-boldsign-api-key

# Seam (Smart Locks)
SEAM_API_KEY=your-seam-api-key

# CORS — Comma-separated frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,https://app.rentalhome.ai,https://www.rentalhome.ai

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
